{
  "installCommand": "npm ci --prefix frontend && npm ci",
  "buildCommand": "REACT_APP_SUPABASE_URL=$SUPABASE_URL REACT_APP_SUPABASE_KEY=$NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY npm run build --prefix frontend",
  "outputDirectory": "frontend/build",
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }]
}
